+/* Process-wide cache of D3D12 root signatures and pipeline states, on with DZN_PERSISTENT_PSO_CACHE=1
+ * (set by ~/libtas-gpu/kumquat.sh). gfxstream (kumquat, the GPU host of libTAS savestates) destroys and
+ * recreates the whole Vulkan instance on every snapshot restore, which made the driver compile every
+ * pipeline again (~7 of 11 s per load in Unleashed Recompiled). With the cache every Vulkan instance
+ * gets the same D3D12 device for an adapter (each instance has its own device factory, which would make
+ * a new device), and identical root signatures and pipeline states come back as the same objects.
+ * It also turns on Mesa's disk cache for the DXIL compiles. Nothing in the cache is ever released. */
+DEBUG_GET_ONCE_BOOL_OPTION(dzn_persistent_pso_cache, "DZN_PERSISTENT_PSO_CACHE", false)
+
+static simple_mtx_t dzn_persistent_lock = SIMPLE_MTX_INITIALIZER;
+static struct hash_table *dzn_persistent_objects;
+static struct {
+   LUID luid;
+   ID3D12Device4 *dev;
+} dzn_persistent_devs[8];
+static unsigned dzn_persistent_dev_count;
+static unsigned dzn_persistent_hits, dzn_persistent_misses;
+
+static uint32_t
+dzn_persistent_key_hash(const void *key)
+{
+   uint32_t h;
+   memcpy(&h, key, sizeof(h));
+   return h;
+}
+
+static bool
+dzn_persistent_key_equal(const void *a, const void *b)
+{
+   return !memcmp(a, b, SHA1_DIGEST_LENGTH);
+}
+
+/* Returns the kept D3D12 device of the adapter with a reference for the caller, or NULL */
+static ID3D12Device4 *
+dzn_persistent_get_device(const LUID *luid)
+{
+   if (!debug_get_option_dzn_persistent_pso_cache())
+      return NULL;
+
+   ID3D12Device4 *dev = NULL;
+   simple_mtx_lock(&dzn_persistent_lock);
+   for (unsigned i = 0; i < dzn_persistent_dev_count; i++) {
+      if (!memcmp(&dzn_persistent_devs[i].luid, luid, sizeof(*luid))) {
+         dev = dzn_persistent_devs[i].dev;
+         ID3D12Device4_AddRef(dev);
+      }
+   }
+   simple_mtx_unlock(&dzn_persistent_lock);
+   return dev;
+}
+
+/* Keeps a reference to the adapter's new D3D12 device, for the next instances */
+static void
+dzn_persistent_keep_device(const LUID *luid, ID3D12Device4 *dev)
+{
+   if (!debug_get_option_dzn_persistent_pso_cache())
+      return;
+
+   simple_mtx_lock(&dzn_persistent_lock);
+   if (!dzn_persistent_objects)
+      dzn_persistent_objects =
+         _mesa_hash_table_create(NULL, dzn_persistent_key_hash, dzn_persistent_key_equal);
+   if (dzn_persistent_objects && dzn_persistent_dev_count < ARRAY_SIZE(dzn_persistent_devs)) {
+      ID3D12Device4_AddRef(dev);
+      dzn_persistent_devs[dzn_persistent_dev_count].luid = *luid;
+      dzn_persistent_devs[dzn_persistent_dev_count].dev = dev;
+      dzn_persistent_dev_count++;
+      fprintf(stderr, "dzn: persistent pipeline cache on, keeping D3D12 device %p\n", (void *)dev);
+   }
+   simple_mtx_unlock(&dzn_persistent_lock);
+}
+
+/* True when the device is a kept one: its objects can be cached (they never get released). */
+static bool
+dzn_persistent_usable(struct dzn_device *device)
+{
+   if (!debug_get_option_dzn_persistent_pso_cache())
+      return false;
+
+   bool usable = false;
+   simple_mtx_lock(&dzn_persistent_lock);
+   for (unsigned i = 0; i < dzn_persistent_dev_count; i++)
+      usable |= (void *)dzn_persistent_devs[i].dev == (void *)device->dev;
+   simple_mtx_unlock(&dzn_persistent_lock);
+   return usable;
+}
+
+/* Returns the cached object with a reference for the caller, or NULL */
+static IUnknown *
+dzn_persistent_lookup(const uint8_t *key)
+{
+   simple_mtx_lock(&dzn_persistent_lock);
+   struct hash_entry *he = _mesa_hash_table_search(dzn_persistent_objects, key);
+   IUnknown *obj = he ? he->data : NULL;
+   if (obj) {
+      IUnknown_AddRef(obj);
+      dzn_persistent_hits++;
+   } else {
+      dzn_persistent_misses++;
+   }
+   simple_mtx_unlock(&dzn_persistent_lock);
+   return obj;
+}
+
+/* Keeps a reference to obj in the cache and returns obj; if another thread stored an object
+ * for the key first, releases obj and returns that one (with a reference for the caller). */
+static IUnknown *
+dzn_persistent_insert(const uint8_t *key, IUnknown *obj)
+{
+   simple_mtx_lock(&dzn_persistent_lock);
+   struct hash_entry *he = _mesa_hash_table_search(dzn_persistent_objects, key);
+   if (he) {
+      IUnknown *existing = he->data;
+      IUnknown_AddRef(existing);
+      simple_mtx_unlock(&dzn_persistent_lock);
+      IUnknown_Release(obj);
+      return existing;
+   }
+   uint8_t *stored_key = malloc(SHA1_DIGEST_LENGTH);
+   if (stored_key) {
+      memcpy(stored_key, key, SHA1_DIGEST_LENGTH);
+      IUnknown_AddRef(obj);
+      _mesa_hash_table_insert(dzn_persistent_objects, stored_key, obj);
+   }
+   simple_mtx_unlock(&dzn_persistent_lock);
+   return obj;
+}
+
+#define PSO_HASH(ctx, value) _mesa_sha1_update(ctx, &(value), sizeof(value))
+
+static void
+dzn_pso_hash_stencil_op(struct mesa_sha1 *ctx, const D3D12_DEPTH_STENCILOP_DESC *op)
+{
+   PSO_HASH(ctx, op->StencilFailOp);
+   PSO_HASH(ctx, op->StencilDepthFailOp);
+   PSO_HASH(ctx, op->StencilPassOp);
+   PSO_HASH(ctx, op->StencilFunc);
+}
+
+static void
+dzn_pso_hash_stencil_op1(struct mesa_sha1 *ctx, const D3D12_DEPTH_STENCILOP_DESC1 *op)
+{
+   PSO_HASH(ctx, op->StencilFailOp);
+   PSO_HASH(ctx, op->StencilDepthFailOp);
+   PSO_HASH(ctx, op->StencilPassOp);
+   PSO_HASH(ctx, op->StencilFunc);
+   PSO_HASH(ctx, op->StencilReadMask);
+   PSO_HASH(ctx, op->StencilWriteMask);
+}
+
+/* Hashes everything a pipeline state stream describes, following its pointers (shader code, input
+ * layout, view instancing). Structs with padding are hashed field by field. Root signatures come
+ * from the cache too, so their pointers identify them. Returns false for subobject types it does
+ * not know: such a pipeline is not cached. */
+static bool
+dzn_pso_stream_key(const void *dev, const D3D12_PIPELINE_STATE_STREAM_DESC *stream, uint8_t *key)
+{
+   struct mesa_sha1 ctx;
+   _mesa_sha1_init(&ctx);
+   _mesa_sha1_update(&ctx, "PipelineState", 13);
+   _mesa_sha1_update(&ctx, &dev, sizeof(dev));
+
+   const uint8_t *base = stream->pPipelineStateSubobjectStream;
+   size_t offset = 0;
+   while (true) {
+      offset = ALIGN_POT(offset, alignof(void *));
+      if (offset >= stream->SizeInBytes)
+         break;
+      D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type;
+      memcpy(&type, base + offset, sizeof(type));
+      PSO_HASH(&ctx, type);
+
+      /* Same layout as d3d12_pipeline_state_stream_new_desc: struct { type; T desc; } */
+#define PSO_SUBOBJECT(T, var)                                                              \
+      const size_t var##_off = ALIGN_POT(sizeof(type), alignof(T));                        \
+      const size_t var##_size =                                                            \
+         ALIGN_POT(var##_off + sizeof(T), MAX2(alignof(T), alignof(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE))); \
+      if (offset + var##_size > stream->SizeInBytes)                                       \
+         return false;                                                                     \
+      const T *var = (const T *)(base + offset + var##_off);                               \
+      offset += var##_size
+
+      switch (type) {
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_HS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_GS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CS: {
+         PSO_SUBOBJECT(D3D12_SHADER_BYTECODE, bc);
+         uint64_t length = bc->BytecodeLength;
+         PSO_HASH(&ctx, length);
+         if (length && !bc->pShaderBytecode)
+            return false;
+         if (length)
+            _mesa_sha1_update(&ctx, bc->pShaderBytecode, length);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE: {
+         PSO_SUBOBJECT(ID3D12RootSignature *, root_sig);
+         PSO_HASH(&ctx, *root_sig);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT: {
+         PSO_SUBOBJECT(D3D12_INPUT_LAYOUT_DESC, layout);
+         PSO_HASH(&ctx, layout->NumElements);
+         for (UINT i = 0; i < layout->NumElements; i++) {
+            const D3D12_INPUT_ELEMENT_DESC *e = &layout->pInputElementDescs[i];
+            if (e->SemanticName)
+               _mesa_sha1_update(&ctx, e->SemanticName, strlen(e->SemanticName) + 1);
+            PSO_HASH(&ctx, e->SemanticIndex);
+            PSO_HASH(&ctx, e->Format);
+            PSO_HASH(&ctx, e->InputSlot);
+            PSO_HASH(&ctx, e->AlignedByteOffset);
+            PSO_HASH(&ctx, e->InputSlotClass);
+            PSO_HASH(&ctx, e->InstanceDataStepRate);
+         }
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VIEW_INSTANCING: {
+         PSO_SUBOBJECT(D3D12_VIEW_INSTANCING_DESC, vi);
+         PSO_HASH(&ctx, vi->ViewInstanceCount);
+         PSO_HASH(&ctx, vi->Flags);
+         if (vi->ViewInstanceCount && !vi->pViewInstanceLocations)
+            return false;
+         for (UINT i = 0; i < vi->ViewInstanceCount; i++) {
+            PSO_HASH(&ctx, vi->pViewInstanceLocations[i].ViewportArrayIndex);
+            PSO_HASH(&ctx, vi->pViewInstanceLocations[i].RenderTargetArrayIndex);
+         }
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND: {
+         PSO_SUBOBJECT(D3D12_BLEND_DESC, blend);
+         PSO_HASH(&ctx, blend->AlphaToCoverageEnable);
+         PSO_HASH(&ctx, blend->IndependentBlendEnable);
+         for (unsigned i = 0; i < ARRAY_SIZE(blend->RenderTarget); i++) {
+            const D3D12_RENDER_TARGET_BLEND_DESC *rt = &blend->RenderTarget[i];
+            PSO_HASH(&ctx, rt->BlendEnable);
+            PSO_HASH(&ctx, rt->LogicOpEnable);
+            PSO_HASH(&ctx, rt->SrcBlend);
+            PSO_HASH(&ctx, rt->DestBlend);
+            PSO_HASH(&ctx, rt->BlendOp);
+            PSO_HASH(&ctx, rt->SrcBlendAlpha);
+            PSO_HASH(&ctx, rt->DestBlendAlpha);
+            PSO_HASH(&ctx, rt->BlendOpAlpha);
+            PSO_HASH(&ctx, rt->LogicOp);
+            PSO_HASH(&ctx, rt->RenderTargetWriteMask);
+         }
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1: {
+         PSO_SUBOBJECT(D3D12_DEPTH_STENCIL_DESC1, ds);
+         PSO_HASH(&ctx, ds->DepthEnable);
+         PSO_HASH(&ctx, ds->DepthWriteMask);
+         PSO_HASH(&ctx, ds->DepthFunc);
+         PSO_HASH(&ctx, ds->StencilEnable);
+         PSO_HASH(&ctx, ds->StencilReadMask);
+         PSO_HASH(&ctx, ds->StencilWriteMask);
+         dzn_pso_hash_stencil_op(&ctx, &ds->FrontFace);
+         dzn_pso_hash_stencil_op(&ctx, &ds->BackFace);
+         PSO_HASH(&ctx, ds->DepthBoundsTestEnable);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL2: {
+         PSO_SUBOBJECT(D3D12_DEPTH_STENCIL_DESC2, ds);
+         PSO_HASH(&ctx, ds->DepthEnable);
+         PSO_HASH(&ctx, ds->DepthWriteMask);
+         PSO_HASH(&ctx, ds->DepthFunc);
+         PSO_HASH(&ctx, ds->StencilEnable);
+         dzn_pso_hash_stencil_op1(&ctx, &ds->FrontFace);
+         dzn_pso_hash_stencil_op1(&ctx, &ds->BackFace);
+         PSO_HASH(&ctx, ds->DepthBoundsTestEnable);
+         break;
+      }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS: {
+         PSO_SUBOBJECT(struct D3D12_RT_FORMAT_ARRAY, rts);
+         PSO_HASH(&ctx, rts->NumRenderTargets);
+         for (UINT i = 0; i < rts->NumRenderTargets && i < ARRAY_SIZE(rts->RTFormats); i++)
+            PSO_HASH(&ctx, rts->RTFormats[i]);
+         break;
+      }
+      /* Plain structs of 4-byte fields */
+#define PSO_PLAIN(id, T)                                    \
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_##id: {      \
+         PSO_SUBOBJECT(T, plain);                           \
+         _mesa_sha1_update(&ctx, plain, sizeof(T));         \
+         break;                                             \
+      }
+      PSO_PLAIN(PRIMITIVE_TOPOLOGY, D3D12_PRIMITIVE_TOPOLOGY_TYPE)
+      PSO_PLAIN(IB_STRIP_CUT_VALUE, D3D12_INDEX_BUFFER_STRIP_CUT_VALUE)
+      PSO_PLAIN(RASTERIZER, D3D12_RASTERIZER_DESC)
+      PSO_PLAIN(RASTERIZER1, D3D12_RASTERIZER_DESC1)
+      PSO_PLAIN(RASTERIZER2, D3D12_RASTERIZER_DESC2)
+      PSO_PLAIN(SAMPLE_DESC, DXGI_SAMPLE_DESC)
+      PSO_PLAIN(SAMPLE_MASK, UINT)
+      PSO_PLAIN(FLAGS, D3D12_PIPELINE_STATE_FLAGS)
+      PSO_PLAIN(DEPTH_STENCIL_FORMAT, DXGI_FORMAT)
+      PSO_PLAIN(NODE_MASK, UINT)
+#undef PSO_PLAIN
+      default:
+         return false;
+      }
+#undef PSO_SUBOBJECT
+   }
+   _mesa_sha1_final(&ctx, key);
+   return true;
+}
+
+HRESULT
+dzn_device_create_pipeline_state(struct dzn_device *device,
+                                 const D3D12_PIPELINE_STATE_STREAM_DESC *stream,
+                                 ID3D12PipelineState **out)
+{
+   uint8_t key[SHA1_DIGEST_LENGTH];
+   bool persistent = dzn_persistent_usable(device) && dzn_pso_stream_key(device->dev, stream, key);
+   if (persistent) {
+      *out = (ID3D12PipelineState *)dzn_persistent_lookup(key);
+      if (*out)
+         return S_OK;
+   }
+
+   HRESULT hres = ID3D12Device4_CreatePipelineState(device->dev, stream,
+                                                    &IID_ID3D12PipelineState,
+                                                    (void **)out);
+   if (persistent && SUCCEEDED(hres))
+      *out = (ID3D12PipelineState *)dzn_persistent_insert(key, (IUnknown *)*out);
+   return hres;
+}

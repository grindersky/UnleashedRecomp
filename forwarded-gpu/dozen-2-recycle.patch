+/* DZN_TIMING=1 (set by ~/libtas-gpu/kumquat.sh): counts and times of the calls a libTAS GPU
+ * savestate load makes, written to stderr (kumquat.log) at the first submit of a new device and
+ * when a device is destroyed. */
+DEBUG_GET_ONCE_BOOL_OPTION(dzn_timing, "DZN_TIMING", false)
+
+enum dzn_stat {
+   DZN_STAT_ALLOC_HEAP,
+   DZN_STAT_ALLOC_BUFFER,
+   DZN_STAT_ALLOC_IMAGE,
+   DZN_STAT_ALLOC_OTHER,
+   DZN_STAT_ALLOC_RECYCLED,
+   DZN_STAT_FREE_RELEASED,
+   DZN_STAT_FREE_PARKED,
+   DZN_STAT_MAP,
+   DZN_STAT_MAP_KEPT,
+   DZN_STAT_RECYCLE_DROPPED,
+   DZN_STAT_COUNT,
+};
+
+static const char *const dzn_stat_names[DZN_STAT_COUNT] = {
+   [DZN_STAT_ALLOC_HEAP] = "AllocateMemory heap",
+   [DZN_STAT_ALLOC_BUFFER] = "AllocateMemory dedicated buffer",
+   [DZN_STAT_ALLOC_IMAGE] = "AllocateMemory dedicated image",
+   [DZN_STAT_ALLOC_OTHER] = "AllocateMemory import/export",
+   [DZN_STAT_ALLOC_RECYCLED] = "AllocateMemory recycled",
+   [DZN_STAT_FREE_RELEASED] = "FreeMemory released",
+   [DZN_STAT_FREE_PARKED] = "FreeMemory parked",
+   [DZN_STAT_MAP] = "MapMemory",
+   [DZN_STAT_MAP_KEPT] = "MapMemory kept mapping",
+   [DZN_STAT_RECYCLE_DROPPED] = "recycle: released unused",
+};
+
+static struct {
+   uint64_t count, ns, bytes;
+} dzn_stats[DZN_STAT_COUNT];
+
+static inline uint64_t
+dzn_timing_now(void)
+{
+   return debug_get_option_dzn_timing() ? os_time_get_nano() : 0;
+}
+
+static inline double
+dzn_ms_since(uint64_t start)
+{
+   return (os_time_get_nano() - start) / 1e6;
+}
+
+static void
+dzn_stat_add(enum dzn_stat stat, uint64_t start, uint64_t bytes)
+{
+   if (!debug_get_option_dzn_timing())
+      return;
+   p_atomic_inc(&dzn_stats[stat].count);
+   p_atomic_add(&dzn_stats[stat].ns, os_time_get_nano() - start);
+   p_atomic_add(&dzn_stats[stat].bytes, bytes);
+}
+
+static void
+dzn_stats_report(const char *when)
+{
+   if (!debug_get_option_dzn_timing())
+      return;
+   fprintf(stderr, "dzn: TIMING %s:\n", when);
+   for (unsigned i = 0; i < DZN_STAT_COUNT; i++) {
+      uint64_t count = p_atomic_xchg(&dzn_stats[i].count, 0);
+      uint64_t ns = p_atomic_xchg(&dzn_stats[i].ns, 0);
+      uint64_t bytes = p_atomic_xchg(&dzn_stats[i].bytes, 0);
+      if (count)
+         fprintf(stderr, "dzn: TIMING   %-34s x%-6" PRIu64 " %8.1f ms %8.1f MB\n",
+                 dzn_stat_names[i], count, ns / 1e6, bytes / 1048576.0);
+   }
+   fflush(stderr);
+}

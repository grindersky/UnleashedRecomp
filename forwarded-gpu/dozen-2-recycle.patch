 static void
+dzn_persistent_meta_key(struct dzn_device *device, uint32_t kind, uint32_t index,
+                        ID3D12RootSignature *root_sig, uint8_t *key)
+{
+   struct mesa_sha1 ctx;
+   _mesa_sha1_init(&ctx);
+   _mesa_sha1_update(&ctx, "MetaPipeline", 12);
+   _mesa_sha1_update(&ctx, &device->dev, sizeof(device->dev));
+   _mesa_sha1_update(&ctx, &kind, sizeof(kind));
+   _mesa_sha1_update(&ctx, &index, sizeof(index));
+   _mesa_sha1_update(&ctx, &root_sig, sizeof(root_sig));
+   _mesa_sha1_final(&ctx, key);
+}
+
+/* Meta pipelines (indirect draw and triangle fan rewrites) are compiled from NIR on every
+ * device creation; with the cache, a new device of the kept D3D12 device reuses them. */
+ID3D12PipelineState *
+dzn_persistent_meta_lookup(struct dzn_device *device, uint32_t kind, uint32_t index,
+                           ID3D12RootSignature *root_sig)
+{
+   if (!dzn_persistent_usable(device))
+      return NULL;
+   uint8_t key[SHA1_DIGEST_LENGTH];
+   dzn_persistent_meta_key(device, kind, index, root_sig, key);
+   return (ID3D12PipelineState *)dzn_persistent_lookup(key);
+}
+
+ID3D12PipelineState *
+dzn_persistent_meta_insert(struct dzn_device *device, uint32_t kind, uint32_t index,
+                           ID3D12RootSignature *root_sig, ID3D12PipelineState *pso)
+{
+   if (!dzn_persistent_usable(device))
+      return pso;
+   uint8_t key[SHA1_DIGEST_LENGTH];
+   dzn_persistent_meta_key(device, kind, index, root_sig, key);
+   return (ID3D12PipelineState *)dzn_persistent_insert(key, (IUnknown *)pso);
+}

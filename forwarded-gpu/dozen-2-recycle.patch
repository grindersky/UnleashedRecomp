+/* DZN_RECYCLE=1 (with DZN_PERSISTENT_PSO_CACHE=1, set by ~/libtas-gpu/kumquat.sh): freed memory
+ * of the kept D3D12 device is parked instead of released, and an allocation with the same size,
+ * type and dedicated image/buffer description takes it back. gfxstream frees all memory on a
+ * savestate load and then allocates the same again, ~1200 D3D12 heaps and committed resources.
+ * Host visible memory also stays mapped. Parked memory is released at the first submit of a newer
+ * device (the load is done allocating by then) or 2 s after it was parked. Dedicated images are
+ * only recycled with enhanced barriers: a recycled texture keeps its layout, and only those
+ * barriers can leave an unknown layout (Vulkan's UNDEFINED). Device descriptor heaps are kept
+ * for the next device too. */
+DEBUG_GET_ONCE_BOOL_OPTION(dzn_recycle, "DZN_RECYCLE", false)
+DEBUG_GET_ONCE_NUM_OPTION(dzn_recycle_max_mb, "DZN_RECYCLE_MAX_MB", 4096)
+
+#define DZN_RECYCLE_MAX_AGE_NS (2ull * 1000 * 1000 * 1000)
+
+static_assert(sizeof(((struct dzn_device_memory *)NULL)->recycle_key) == SHA1_DIGEST_LENGTH,
+              "recycle_key holds a mesa-sha1 digest");
+
+struct dzn_recycled_mem {
+   struct list_head link;        /* all parked memory, oldest first */
+   struct list_head bucket_link; /* parked memory of the same key */
+   uint8_t key[SHA1_DIGEST_LENGTH];
+   uint64_t parked_ns;
+   uint64_t serial;
+   uint64_t bytes;
+   ID3D12Heap *heap;
+   ID3D12Resource *dedicated_res;
+   ID3D12Resource *map_res;
+   void *kept_map;
+};
+
+struct dzn_recycle_bucket {
+   uint8_t key[SHA1_DIGEST_LENGTH];
+   struct list_head entries;
+};
+
+static simple_mtx_t dzn_recycle_lock = SIMPLE_MTX_INITIALIZER;
+static struct list_head dzn_recycle_list;
+static struct hash_table *dzn_recycle_buckets;
+static uint64_t dzn_recycle_bytes;
+static uint32_t dzn_recycle_count;
+static uint64_t dzn_recycle_next_serial;
+
+static struct {
+   ID3D12Device4 *dev;
+   D3D12_DESCRIPTOR_HEAP_TYPE type;
+   struct dzn_descriptor_heap heap;
+} dzn_parked_desc_heaps[8];
+static unsigned dzn_parked_desc_heap_count;
+
+static bool
+dzn_recycle_usable(struct dzn_device *device)
+{
+   return debug_get_option_dzn_recycle() && dzn_persistent_usable(device);
+}
+
+static void
+dzn_recycled_mem_release(struct dzn_recycled_mem *e)
+{
+   if (e->kept_map)
+      ID3D12Resource_Unmap(e->map_res, 0, NULL);
+   if (e->map_res)
+      ID3D12Resource_Release(e->map_res);
+   if (e->heap)
+      ID3D12Heap_Release(e->heap);
+   if (e->dedicated_res)
+      ID3D12Resource_Release(e->dedicated_res);
+   free(e);
+}
+
+/* Takes parked memory made for key into mem; false if there is none */
+static bool
+dzn_recycle_take(const uint8_t *key, struct dzn_device_memory *mem)
+{
+   struct dzn_recycled_mem *e = NULL;
+   simple_mtx_lock(&dzn_recycle_lock);
+   struct hash_entry *he =
+      dzn_recycle_buckets ? _mesa_hash_table_search(dzn_recycle_buckets, key) : NULL;
+   if (he) {
+      struct dzn_recycle_bucket *bucket = he->data;
+      if (!list_is_empty(&bucket->entries)) {
+         e = list_first_entry(&bucket->entries, struct dzn_recycled_mem, bucket_link);
+         list_del(&e->bucket_link);
+         list_del(&e->link);
+         dzn_recycle_bytes -= e->bytes;
+         p_atomic_dec(&dzn_recycle_count);
+      }
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+   if (!e)
+      return false;
+
+   mem->heap = e->heap;
+   mem->dedicated_res = e->dedicated_res;
+   mem->map_res = e->map_res;
+   mem->kept_map = e->kept_map;
+   free(e);
+   return true;
+}
+
+/* Parks the D3D12 objects of mem; false (and nothing changed) if it can't */
+static bool
+dzn_recycle_park(struct dzn_device *device, struct dzn_device_memory *mem)
+{
+   struct dzn_recycled_mem *e = calloc(1, sizeof(*e));
+   if (!e)
+      return false;
+   memcpy(e->key, mem->recycle_key, sizeof(e->key));
+   e->parked_ns = os_time_get_nano();
+   e->serial = device->recycle_serial;
+   e->bytes = mem->size;
+   e->heap = mem->heap;
+   e->dedicated_res = mem->dedicated_res;
+   e->map_res = mem->map_res;
+   e->kept_map = mem->kept_map;
+
+   simple_mtx_lock(&dzn_recycle_lock);
+   if (!dzn_recycle_buckets) {
+      list_inithead(&dzn_recycle_list);
+      dzn_recycle_buckets =
+         _mesa_hash_table_create(NULL, dzn_persistent_key_hash, dzn_persistent_key_equal);
+   }
+   struct hash_entry *he =
+      dzn_recycle_buckets ? _mesa_hash_table_search(dzn_recycle_buckets, e->key) : NULL;
+   struct dzn_recycle_bucket *bucket = he ? he->data : NULL;
+   if (!bucket && dzn_recycle_buckets) {
+      bucket = calloc(1, sizeof(*bucket));
+      if (bucket) {
+         memcpy(bucket->key, e->key, sizeof(bucket->key));
+         list_inithead(&bucket->entries);
+         _mesa_hash_table_insert(dzn_recycle_buckets, bucket->key, bucket);
+      }
+   }
+   bool parked = bucket &&
+      dzn_recycle_bytes + e->bytes <= (uint64_t)debug_get_option_dzn_recycle_max_mb() << 20;
+   if (parked) {
+      list_addtail(&e->link, &dzn_recycle_list);
+      list_addtail(&e->bucket_link, &bucket->entries);
+      dzn_recycle_bytes += e->bytes;
+      p_atomic_inc(&dzn_recycle_count);
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+
+   if (!parked) {
+      free(e);
+      return false;
+   }
+   mem->heap = NULL;
+   mem->dedicated_res = NULL;
+   mem->map_res = NULL;
+   mem->kept_map = NULL;
+   mem->map = NULL;
+   return true;
+}
+
+/* Releases parked memory a device can't take anymore: from an older device, or too old */
+static void
+dzn_recycle_drain(struct dzn_device *device)
+{
+   if (!device->recycle_reported) {
+      device->recycle_reported = true;
+      if (debug_get_option_dzn_timing()) {
+         char when[96];
+         snprintf(when, sizeof(when), "first submit of device %" PRIu64 " (%u parked unused)",
+                  device->recycle_serial, p_atomic_read(&dzn_recycle_count));
+         dzn_stats_report(when);
+      }
+   }
+   if (!p_atomic_read(&dzn_recycle_count))
+      return;
+
+   uint64_t now = os_time_get_nano();
+   struct list_head dropped;
+   list_inithead(&dropped);
+   simple_mtx_lock(&dzn_recycle_lock);
+   list_for_each_entry_safe(struct dzn_recycled_mem, e, &dzn_recycle_list, link) {
+      if (e->serial < device->recycle_serial || now - e->parked_ns > DZN_RECYCLE_MAX_AGE_NS) {
+         list_del(&e->bucket_link);
+         list_del(&e->link);
+         dzn_recycle_bytes -= e->bytes;
+         p_atomic_dec(&dzn_recycle_count);
+         list_addtail(&e->link, &dropped);
+      }
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+
+   list_for_each_entry_safe(struct dzn_recycled_mem, e, &dropped, link) {
+      uint64_t start = dzn_timing_now();
+      uint64_t bytes = e->bytes;
+      dzn_recycled_mem_release(e);
+      dzn_stat_add(DZN_STAT_RECYCLE_DROPPED, start, bytes);
+   }
+}
+
+/* Device descriptor heaps (bindless) of the kept D3D12 device, for the next device */
+static bool
+dzn_recycle_take_desc_heap(struct dzn_device *device, D3D12_DESCRIPTOR_HEAP_TYPE type,
+                           uint32_t desc_count, struct dzn_descriptor_heap *out)
+{
+   if (!dzn_recycle_usable(device))
+      return false;
+   bool found = false;
+   simple_mtx_lock(&dzn_recycle_lock);
+   for (unsigned i = 0; i < dzn_parked_desc_heap_count; i++) {
+      if ((void *)dzn_parked_desc_heaps[i].dev == (void *)device->dev &&
+          dzn_parked_desc_heaps[i].type == type &&
+          dzn_parked_desc_heaps[i].heap.desc_count == desc_count) {
+         *out = dzn_parked_desc_heaps[i].heap;
+         dzn_parked_desc_heaps[i] = dzn_parked_desc_heaps[--dzn_parked_desc_heap_count];
+         found = true;
+         break;
+      }
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+   return found;
+}
+
+static bool
+dzn_recycle_park_desc_heap(struct dzn_device *device, D3D12_DESCRIPTOR_HEAP_TYPE type,
+                           struct dzn_descriptor_heap *heap)
+{
+   if (!heap->heap || !dzn_recycle_usable(device))
+      return false;
+   bool parked = false;
+   simple_mtx_lock(&dzn_recycle_lock);
+   if (dzn_parked_desc_heap_count < ARRAY_SIZE(dzn_parked_desc_heaps)) {
+      dzn_parked_desc_heaps[dzn_parked_desc_heap_count].dev = device->dev;
+      dzn_parked_desc_heaps[dzn_parked_desc_heap_count].type = type;
+      dzn_parked_desc_heaps[dzn_parked_desc_heap_count].heap = *heap;
+      dzn_parked_desc_heap_count++;
+      parked = true;
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+   if (parked)
+      heap->heap = NULL;
+   return parked;
+}
+
+/* Command queues (and their fences) of the kept D3D12 device, for the next device. Creating one
+ * takes ~50 ms in WSL, and gfxstream's device has 9. The fence keeps counting from where the
+ * old queue stopped, so values the new queue signals are always newer. */
+static struct {
+   ID3D12Device4 *dev;
+   D3D12_COMMAND_QUEUE_DESC desc;
+   ID3D12CommandQueue *cmdqueue;
+   ID3D12Fence *fence;
+   uint64_t fence_point;
+} dzn_parked_queues[32];
+static unsigned dzn_parked_queue_count;
+
+static bool
+dzn_recycle_take_queue(struct dzn_device *device, struct dzn_queue *queue,
+                       const D3D12_COMMAND_QUEUE_DESC *desc)
+{
+   if (!dzn_recycle_usable(device))
+      return false;
+   bool found = false;
+   simple_mtx_lock(&dzn_recycle_lock);
+   for (unsigned i = 0; i < dzn_parked_queue_count; i++) {
+      if ((void *)dzn_parked_queues[i].dev == (void *)device->dev &&
+          !memcmp(&dzn_parked_queues[i].desc, desc, sizeof(*desc))) {
+         queue->cmdqueue = dzn_parked_queues[i].cmdqueue;
+         queue->fence = dzn_parked_queues[i].fence;
+         queue->fence_point = dzn_parked_queues[i].fence_point;
+         dzn_parked_queues[i] = dzn_parked_queues[--dzn_parked_queue_count];
+         found = true;
+         break;
+      }
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+   return found;
+}
+
+/* Parks the idle queue's D3D12 objects; false (and nothing changed) if it can't */
+static bool
+dzn_recycle_park_queue(struct dzn_queue *queue)
+{
+   struct dzn_device *device = container_of(queue->vk.base.device, struct dzn_device, vk);
+   if (!queue->cmdqueue || !queue->fence || !dzn_recycle_usable(device))
+      return false;
+   bool parked = false;
+   simple_mtx_lock(&dzn_recycle_lock);
+   if (dzn_parked_queue_count < ARRAY_SIZE(dzn_parked_queues)) {
+      dzn_parked_queues[dzn_parked_queue_count].dev = device->dev;
+      dzn_parked_queues[dzn_parked_queue_count].desc = queue->d3d12_desc;
+      dzn_parked_queues[dzn_parked_queue_count].cmdqueue = queue->cmdqueue;
+      dzn_parked_queues[dzn_parked_queue_count].fence = queue->fence;
+      dzn_parked_queues[dzn_parked_queue_count].fence_point = queue->fence_point;
+      dzn_parked_queue_count++;
+      parked = true;
+   }
+   simple_mtx_unlock(&dzn_recycle_lock);
+   if (parked) {
+      queue->cmdqueue = NULL;
+      queue->fence = NULL;
+   }
+   return parked;
+}
+
+#define MEM_HASH(ctx, value) _mesa_sha1_update(ctx, &(value), sizeof(value))
+
+static void
+dzn_recycle_hash_resource_desc(struct mesa_sha1 *ctx, const D3D12_RESOURCE_DESC *desc)
+{
+   MEM_HASH(ctx, desc->Dimension);
+   MEM_HASH(ctx, desc->Alignment);
+   MEM_HASH(ctx, desc->Width);
+   MEM_HASH(ctx, desc->Height);
+   MEM_HASH(ctx, desc->DepthOrArraySize);
+   MEM_HASH(ctx, desc->MipLevels);
+   MEM_HASH(ctx, desc->Format);
+   MEM_HASH(ctx, desc->SampleDesc.Count);
+   MEM_HASH(ctx, desc->SampleDesc.Quality);
+   MEM_HASH(ctx, desc->Layout);
+   MEM_HASH(ctx, desc->Flags);
+}

+// The host can replace the guest timebase (mftb), which otherwise reads the CPU's time stamp counter,
+// e.g. so that a tool controlling time (such as libTAS) also controls the guest's timebase.
+inline uint64_t (*g_ppcTimebaseOverride)() = nullptr;
+
+inline uint64_t PPCReadTimebase()
+{
+    return g_ppcTimebaseOverride != nullptr ? g_ppcTimebaseOverride() : __rdtsc();
+}

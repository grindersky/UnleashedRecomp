+    uint32_t idNode = FindMapNode(stateMachine + 20, name, 21);
+    uint32_t stateNode = idNode != 0 ? FindMapNode(stateMachine + 8, LoadU16(idNode + 16)) : 0;
+    return stateNode != 0 ? LoadU32(stateNode + 16) : 0;
+}
